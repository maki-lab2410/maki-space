<IfModule mod_rewrite.c>
    RewriteEngine On
    # Membelokkan semua akses pengunjung masuk ke folder public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

# Memblokir akses langsung ke file konfigurasi rahasia & file sistem & arsip
<FilesMatch "(^\.env.*|composer\.(json|lock)|package(-lock)?\.json|artisan|phpunit\.xml|\.git.*|\.deploy.*|deploy\.(py|sh)|\.(zip|tar|gz|sql|log|sqlite|key|bak|sh|py))$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Cegah directory listing
Options -Indexes