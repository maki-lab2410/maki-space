# ─── KONFIGURASI AUTO-DEPLOY FTP MAKI SPACE ─────────────────────────────
# Salin file ini menjadi .env.deploy dan isi dengan data FTP cPanel Anda:
# cp .env.deploy.example .env.deploy

FTP_HOST=ftp.your-domain.com
FTP_PORT=21
FTP_USER=your_ftp_username
FTP_PASS=your_ftp_password

# Path folder inti Laravel di server hosting (sesuai letak maki-space-core):
FTP_REMOTE_ROOT=maki-space-core

# Gunakan TLS / FTPS (true jika server mewajibkan FTPS, false untuk FTP standar)
FTP_SSL=false

# URL pembersih cache otomatis setelah upload berhasil (opsional)
CACHE_CLEAR_URL=https://your-domain.com/clear-cache?token=your_secret_token
